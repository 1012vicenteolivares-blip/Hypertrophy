```html
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>HypertrophyOS Cloud — Torso-Pierna Pro</title>

  <!-- Metadatos PWA para iPhone (iOS Safari) y Android (Chrome) -->
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="HypertrophyOS" />
  <meta name="application-name" content="HypertrophyOS" />
  <meta name="theme-color" content="#0B0F17" />
  <meta name="description" content="Sistema inteligente de entrenamiento Torso-Pierna con Doble Progresión, e1RM, Macro/Mesociclos y sincronización en la nube." />

  <!-- Íconos y Manifest inyectados dinámicamente al cargar -->
  <link id="dynamic-favicon" rel="icon" type="image/png" href="" />
  <link id="dynamic-apple-icon" rel="apple-touch-icon" sizes="180x180" href="" />
  <link id="dynamic-manifest" rel="manifest" href="" />

  <!-- Google Fonts: Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
          },
          colors: {
            obsidian: '#0B0F17',
            cardbg: '#131A26',
            cardhover: '#192233',
            emeraldbrand: '#10B981',
            cyanbrand: '#06B6D4',
          }
        }
      }
    };
  </script>

  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#0B0F17] text-slate-100 font-sans antialiased selection:bg-emerald-500/30 selection:text-emerald-200 overflow-x-hidden">

  <!-- Contenedor principal -->
  <div class="min-h-screen flex flex-col lg:flex-row">

    <!-- ==================== SIDEBAR ESCRITORIO ==================== -->
    <aside class="hidden lg:flex lg:flex-col lg:w-64 lg:fixed lg:inset-y-0 bg-[#0F1520] border-r border-slate-800/80 z-30">
      <!-- Marca -->
      <div class="px-5 py-5 border-b border-slate-800/80 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-cyan-500 flex items-center justify-center shadow-lg shadow-emerald-500/20 shrink-0">
          <i data-lucide="dumbbell" class="w-5 h-5 text-[#0B0F17] stroke-[2.5]"></i>
        </div>
        <div class="min-w-0">
          <h1 class="text-base font-extrabold tracking-tight text-white leading-tight truncate">HypertrophyOS</h1>
          <p class="text-[11px] font-bold text-emerald-400 uppercase tracking-wider">Cloud · Torso-Pierna</p>
        </div>
      </div>

      <!-- Estado de Nube en Sidebar -->
      <div class="px-4 pt-3.5 pb-1">
        <button onclick="navigateTo('cloud')" id="desktop-cloud-badge" class="w-full px-3 py-2 rounded-xl bg-[#131A26] hover:bg-[#192233] border border-slate-800 flex items-center justify-between gap-2 transition text-left">
          <!-- Renderizado por JS -->
        </button>
      </div>

      <!-- Navegación escritorio -->
      <nav id="desktop-nav" class="flex-1 px-3 py-3 space-y-1 overflow-y-auto">
        <!-- Renderizado por JS -->
      </nav>

      <!-- Tarjeta de Mesociclo Activo -->
      <div class="p-4 border-t border-slate-800/80">
        <div id="sidebar-cycle-card" class="p-3.5 rounded-xl bg-[#0B0F17] border border-slate-800/90 space-y-2">
          <!-- Renderizado por JS -->
        </div>
      </div>
    </aside>

    <!-- ==================== CABECERA MÓVIL (con safe-area iPhone) ==================== -->
    <header class="lg:hidden sticky top-0 z-30 bg-[#0F1520]/95 backdrop-blur-xl border-b border-slate-800/80 px-4 pb-3 pt-[max(0.75rem,env(safe-area-inset-top))] flex items-center justify-between gap-2">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-emerald-500 to-cyan-500 flex items-center justify-center shrink-0 shadow-md shadow-emerald-500/20">
          <i data-lucide="dumbbell" class="w-4 h-4 text-[#0B0F17] stroke-[2.5]"></i>
        </div>
        <div class="min-w-0">
          <div class="text-sm font-extrabold text-white leading-tight truncate">HypertrophyOS</div>
          <div id="mobile-header-cycle" class="text-[11px] text-cyan-400 font-medium truncate">Mesociclo activo</div>
        </div>
      </div>

      <div class="flex items-center gap-1.5 shrink-0">
        <!-- Badge de estado de nube clickeable -->
        <button onclick="navigateTo('cloud')" id="mobile-cloud-badge" class="px-2.5 py-1.5 rounded-xl bg-[#131A26] border border-slate-800 flex items-center gap-1.5 text-[11px] font-bold active:scale-95 transition">
          <!-- Renderizado por JS -->
        </button>
        <button onclick="navigateTo('history')" class="p-2 rounded-xl bg-[#131A26] border border-slate-800 text-slate-300 hover:text-white active:scale-95 transition" title="Historial">
          <i data-lucide="history" class="w-4 h-4"></i>
        </button>
      </div>
    </header>

    <!-- ==================== CONTENIDO PRINCIPAL ==================== -->
    <main class="flex-1 lg:pl-64 pb-[calc(5.5rem+env(safe-area-inset-bottom))] lg:pb-12 min-w-0">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-7">
        <div id="app-view" class="space-y-6"></div>
      </div>
    </main>

    <!-- ==================== BARRA INFERIOR MÓVIL (con safe-area iPhone) ==================== -->
    <nav id="mobile-nav" class="lg:hidden fixed bottom-0 inset-x-0 z-30 bg-[#0F1520]/95 backdrop-blur-xl border-t border-slate-800/80 px-2 pt-1.5 pb-[max(0.5rem,env(safe-area-inset-bottom))] flex items-center justify-around">
      <!-- Renderizado por JS -->
    </nav>
  </div>

  <!-- ==================== TEMPORIZADOR DE DESCANSO FLOTANTE ==================== -->
  <div id="rest-timer-widget" class="hidden fixed bottom-[calc(4.75rem+env(safe-area-inset-bottom))] lg:bottom-6 right-4 left-4 sm:left-auto sm:w-80 z-40 rounded-2xl bg-[#131A26]/95 backdrop-blur-xl border border-emerald-500/40 shadow-2xl shadow-black/70 p-3.5 transition-all">
    <div class="flex items-center justify-between gap-2 mb-2">
      <div class="flex items-center gap-2 min-w-0">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
        <span id="timer-exercise-label" class="text-xs font-semibold text-slate-300 truncate">Descanso</span>
      </div>
      <button onclick="stopRestTimer()" class="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition" title="Cerrar temporizador">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
    <div class="flex items-center justify-between gap-3 mb-2.5">
      <div id="timer-display" class="text-3xl font-extrabold tabular-nums tracking-tight text-white">02:00</div>
      <div class="flex items-center gap-1.5">
        <button onclick="adjustRestTimer(-15)" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-200 active:scale-95 transition">-15s</button>
        <button onclick="togglePauseRestTimer()" id="timer-pause-btn" class="p-2 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 active:scale-95 transition" title="Pausar/Reanudar">
          <i data-lucide="pause" class="w-4 h-4"></i>
        </button>
        <button onclick="adjustRestTimer(15)" class="px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-bold text-slate-200 active:scale-95 transition">+15s</button>
      </div>
    </div>
    <div class="w-full h-1.5 rounded-full bg-slate-800 overflow-hidden">
      <div id="timer-progress" class="h-full bg-gradient-to-r from-emerald-400 to-cyan-400 transition-all duration-300" style="width: 100%"></div>
    </div>
  </div>

  <!-- ==================== MODAL UNIVERSAL (Cero alert/confirm nativo) ==================== -->
  <div id="modal-backdrop" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
    <div id="modal-box" class="w-full max-w-lg rounded-2xl bg-[#131A26] border border-slate-700/80 shadow-2xl overflow-hidden my-auto">
      <div class="px-5 py-4 border-b border-slate-800 flex items-center justify-between gap-3">
        <h3 id="modal-title" class="text-base font-bold text-white">Título</h3>
        <button onclick="closeModal()" class="p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      </div>
      <div id="modal-body" class="p-5 max-h-[75vh] overflow-y-auto"></div>
      <div id="modal-footer" class="px-5 py-3.5 bg-[#0B0F17]/80 border-t border-slate-800 flex items-center justify-end gap-2"></div>
    </div>
  </div>

  <!-- ==================== TOASTS ==================== -->
  <div id="toast-container" class="fixed top-[max(1rem,env(safe-area-inset-top))] right-4 z-50 flex flex-col gap-2 max-w-sm w-[calc(100%-2rem)] pointer-events-none"></div>

  <!-- Input oculto para importar JSON -->
  <input type="file" id="json-import-input" accept=".json,application/json" class="hidden" />

  <!-- ==================== SCRIPT PRINCIPAL (ES MODULE + FIREBASE 11) ==================== -->
  <script type="module">
    import { initializeApp, getApps, deleteApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
    import {
      getAuth,
      signInAnonymously,
      signInWithCustomToken,
      createUserWithEmailAndPassword,
      signInWithEmailAndPassword,
      signOut,
      onAuthStateChanged
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
    import {
      getFirestore,
      doc,
      getDoc,
      setDoc,
      onSnapshot
    } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

    /*************************************************************************
     * 0. CONFIGURACIÓN MANUAL DE FIREBASE (OPCIONAL SI LO SUBES A NETLIFY)
     * -----------------------------------------------------------------------
     * Si deseas dejar tu propia nube Firebase fija dentro de este archivo HTML,
     * pega aquí tu objeto firebaseConfig de la consola de Firebase (Plan Spark Gratis).
     * También puedes pegarlo directamente desde la app sin tocar código en:
     * "Nube y Cuenta" -> "Configurar mi Firebase Gratis".
     *************************************************************************/
    const CUSTOM_FIREBASE_CONFIG = {
      apiKey: "",
      authDomain: "",
      projectId: "",
      storageBucket: "",
      messagingSenderId: "",
      appId: ""
    };

    const APP_ID = typeof __app_id !== 'undefined' ? __app_id : 'hypertrophy-os-cloud';
    const LOCAL_DB_KEY = 'hypertrophyOS_cloud_state_v2';
    const LOCAL_FB_CFG_KEY = 'hypertrophyOS_custom_fb_cfg_v2';
    const IDB_NAME = 'HypertrophyOSCloudDB';
    const IDB_STORE = 'kv';

    /*************************************************************************
     * 1. GENERADOR DINÁMICO DE ÍCONO PWA Y MANIFEST (iOS & ANDROID)
     *************************************************************************/
    function initDynamicPWAAssets() {
      try {
        const generateIconDataURL = (size) => {
          const canvas = document.createElement('canvas');
          canvas.width = size;
          canvas.height = size;
          const ctx = canvas.getContext('2d');

          // Fondo oscuro con degradado sutil
          const grad = ctx.createLinearGradient(0, 0, size, size);
          grad.addColorStop(0, '#0F172A');
          grad.addColorStop(1, '#0B0F17');
          ctx.fillStyle = grad;
          ctx.fillRect(0, 0, size, size);

          // Brillo esmeralda radial suave
          const glow = ctx.createRadialGradient(size * 0.5, size * 0.45, size * 0.05, size * 0.5, size * 0.5, size * 0.5);
          glow.addColorStop(0, 'rgba(16, 185, 129, 0.28)');
          glow.addColorStop(1, 'rgba(16, 185, 129, 0)');
          ctx.fillStyle = glow;
          ctx.fillRect(0, 0, size, size);

          // Gráfico ascendente de fondo
          ctx.strokeStyle = 'rgba(6, 182, 212, 0.45)';
          ctx.lineWidth = size * 0.032;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';
          ctx.beginPath();
          ctx.moveTo(size * 0.16, size * 0.76);
          ctx.lineTo(size * 0.38, size * 0.62);
          ctx.lineTo(size * 0.58, size * 0.68);
          ctx.lineTo(size * 0.84, size * 0.26);
          ctx.stroke();

          // Mancuerna / Barra esmeralda estilizada
          const barGrad = ctx.createLinearGradient(size * 0.2, size * 0.3, size * 0.8, size * 0.7);
          barGrad.addColorStop(0, '#10B981');
          barGrad.addColorStop(1, '#06B6D4');
          ctx.fillStyle = barGrad;

          const drawRoundRect = (x, y, w, h, r) => {
            ctx.beginPath();
            ctx.moveTo(x + r, y);
            ctx.lineTo(x + w - r, y);
            ctx.quadraticCurveTo(x + w, y, x + w, y + r);
            ctx.lineTo(x + w, y + h - r);
            ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
            ctx.lineTo(x + r, y + h);
            ctx.quadraticCurveTo(x, y + h, x, y + h - r);
            ctx.lineTo(x, y + r);
            ctx.quadraticCurveTo(x, y, x + r, y);
            ctx.closePath();
            ctx.fill();
          };

          // Barra central
          drawRoundRect(size * 0.26, size * 0.455, size * 0.48, size * 0.09, size * 0.04);
          // Discos internos
          drawRoundRect(size * 0.22, size * 0.30, size * 0.10, size * 0.40, size * 0.04);
          drawRoundRect(size * 0.68, size * 0.30, size * 0.10, size * 0.40, size * 0.04);
          // Discos externos
          drawRoundRect(size * 0.12, size * 0.36, size * 0.08, size * 0.28, size * 0.035);
          drawRoundRect(size * 0.80, size * 0.36, size * 0.08, size * 0.28, size * 0.035);

          return canvas.toDataURL('image/png');
        };

        const icon180 = generateIconDataURL(180);
        const icon512 = generateIconDataURL(512);

        const fav = document.getElementById('dynamic-favicon');
        const apple = document.getElementById('dynamic-apple-icon');
        if (fav) fav.href = icon180;
        if (apple) apple.href = icon180;

        // Manifest dinámico para Android Chrome / instalación PWA
        const manifest = {
          name: 'HypertrophyOS Cloud — Torso-Pierna Pro',
          short_name: 'HypertrophyOS',
          description: 'Entrenamiento Torso-Pierna científico con Doble Progresión, PRs y nube.',
          start_url: '.',
          display: 'standalone',
          orientation: 'portrait',
          background_color: '#0B0F17',
          theme_color: '#0B0F17',
          icons: [
            { src: icon180, sizes: '180x180', type: 'image/png', purpose: 'any' },
            { src: icon512, sizes: '512x512', type: 'image/png', purpose: 'any maskable' }
          ]
        };

        const blob = new Blob([JSON.stringify(manifest)], { type: 'application/manifest+json' });
        const manifestURL = URL.createObjectURL(blob);
        const manLink = document.getElementById('dynamic-manifest');
        if (manLink) manLink.href = manifestURL;
      } catch (err) {
        console.warn('No se pudo generar el ícono/manifest PWA dinámico:', err);
      }
    }

    /*************************************************************************
     * 2. ALMACENAMIENTO LOCAL RESILIENTE (IndexedDB + LocalStorage Fallback)
     *************************************************************************/
    const LocalStore = {
      dbPromise: null,
      openDB() {
        if (this.dbPromise) return this.dbPromise;
        this.dbPromise = new Promise((resolve) => {
          try {
            if (!window.indexedDB) return resolve(null);
            const req = indexedDB.open(IDB_NAME, 1);
            req.onupgradeneeded = (e) => {
              const db = e.target.result;
              if (!db.objectStoreNames.contains(IDB_STORE)) {
                db.createObjectStore(IDB_STORE);
              }
            };
            req.onsuccess = () => resolve(req.result);
            req.onerror = () => resolve(null);
          } catch (e) {
            resolve(null);
          }
        });
        return this.dbPromise;
      },
      async get(key) {
        // Primero intenta IndexedDB (más resistente en iOS PWA), luego localStorage
        try {
          const db = await this.openDB();
          if (db) {
            const val = await new Promise((resolve) => {
              const tx = db.transaction(IDB_STORE, 'readonly');
              const req = tx.objectStore(IDB_STORE).get(key);
              req.onsuccess = () => resolve(req.result ?? null);
              req.onerror = () => resolve(null);
            });
            if (val !== null && val !== undefined) return val;
          }
        } catch (e) {}
        try {
          const raw = window.localStorage.getItem(key);
          return raw ? JSON.parse(raw) : null;
        } catch (e) {
          return null;
        }
      },
      async set(key, value) {
        try {
          window.localStorage.setItem(key, JSON.stringify(value));
        } catch (e) {}
        try {
          const db = await this.openDB();
          if (db) {
            await new Promise((resolve) => {
              const tx = db.transaction(IDB_STORE, 'readwrite');
              tx.objectStore(IDB_STORE).put(value, key);
              tx.oncomplete = () => resolve(true);
              tx.onerror = () => resolve(false);
            });
          }
        } catch (e) {}
      },
      async remove(key) {
        try { window.localStorage.removeItem(key); } catch (e) {}
        try {
          const db = await this.openDB();
          if (db) {
            await new Promise((resolve) => {
              const tx = db.transaction(IDB_STORE, 'readwrite');
              tx.objectStore(IDB_STORE).delete(key);
              tx.oncomplete = () => resolve(true);
              tx.onerror = () => resolve(false);
            });
          }
        } catch (e) {}
      }
    };

    /*************************************************************************
     * 3. RUTINA TORSO-PIERNA BASE (4 DÍAS · 2 SERIES EFECTIVAS)
     *************************************************************************/
    const MUSCLE_GROUPS = [
      'Pecho',
      'Espalda',
      'Hombro',
      'Hombro Posterior',
      'Tríceps',
      'Bíceps',
      'Cuádriceps',
      'Isquios',
      'Isquios/Glúteo',
      'Glúteo',
      'Cuádriceps/Glúteo',
      'Aductores',
      'Gemelos',
      'Core'
    ];

    function getDefaultRoutine() {
      return [
        {
          id: 'day_torso_a',
          name: 'Torso A',
          subtitle: 'Pecho Inclinado, Dorsal, Espalda Alta y Brazos en Estiramiento',
          exercises: [
            {
              id: 'ex_ta_1',
              name: 'Press Inclinado (Máquina / Multipower 30°)',
              muscle: 'Pecho',
              sets: 2,
              repMin: 6,
              repMax: 8,
              rirTarget: '1-2',
              restSec: 180,
              notes: 'Inclinación 30° optimiza el haz clavicular sin sobrecargar deltoides anterior.'
            },
            {
              id: 'ex_ta_2',
              name: 'Jalón al Pecho Agarre Neutro',
              muscle: 'Espalda',
              sets: 2,
              repMin: 8,
              repMax: 10,
              rirTarget: '1-2',
              restSec: 180,
              notes: 'Codos pegados al torso para alinear la carga con el dorsal ancho.'
            },
            {
              id: 'ex_ta_3',
              name: 'Remo con Apoyo al Pecho (Agarre Ancho)',
              muscle: 'Espalda',
              sets: 2,
              repMin: 8,
              repMax: 10,
              rirTarget: '1-2',
              restSec: 120,
              notes: 'Pecho apoyado para trabajar trapecio medio y romboides sin fatiga lumbar.'
            },
            {
              id: 'ex_ta_4',
              name: 'Elevaciones Laterales en Polea (Altura muñeca)',
              muscle: 'Hombro',
              sets: 2,
              repMin: 10,
              repMax: 15,
              rirTarget: '0-1',
              restSec: 120,
              notes: 'Torque constante desde el estiramiento en plano escapular.'
            },
            {
              id: 'ex_ta_5',
              name: 'Extensión de Tríceps Sobre la Cabeza en Polea',
              muscle: 'Tríceps',
              sets: 2,
              repMin: 10,
              repMax: 12,
              rirTarget: '0-1',
              restSec: 90,
              notes: 'Hombro flexionado maximiza hipertrofia mediada por estiramiento de la cabeza larga.'
            },
            {
              id: 'ex_ta_6',
              name: 'Curl de Bíceps en Polea Baja (Brazo atrás)',
              muscle: 'Bíceps',
              sets: 2,
              repMin: 10,
              repMax: 12,
              rirTarget: '0-1',
              restSec: 90,
              notes: 'Hombro extendido carga el bíceps en máximo estiramiento sin balanceo.'
            }
          ]
        },
        {
          id: 'day_pierna_a',
          name: 'Pierna A',
          subtitle: 'Cuádriceps, Cadena Posterior, Gemelos y Core',
          exercises: [
            {
              id: 'ex_pa_1',
              name: 'Sentadilla Hack / Prensa 45°',
              muscle: 'Cuádriceps',
              sets: 2,
              repMin: 6,
              repMax: 8,
              rirTarget: '1-2',
              restSec: 180,
              notes: 'Máxima flexión de rodilla sin despegar lumbar del respaldo.'
            },
            {
              id: 'ex_pa_2',
              name: 'Curl Femoral Sentado',
              muscle: 'Isquios',
              sets: 2,
              repMin: 8,
              repMax: 12,
              rirTarget: '1-2',
              restSec: 150,
              notes: 'Cadera flexionada preestira los isquios para mayor hipertrofia.'
            },
            {
              id: 'ex_pa_3',
              name: 'Peso Muerto Rumano',
              muscle: 'Isquios/Glúteo',
              sets: 2,
              repMin: 6,
              repMax: 8,
              rirTarget: '1-2',
              restSec: 180,
              notes: 'Cadera atrás con espalda neutra hasta máximo estiramiento.'
            },
            {
              id: 'ex_pa_4',
              name: 'Extensión de Cuádriceps en Máquina',
              muscle: 'Cuádriceps',
              sets: 2,
              repMin: 10,
              repMax: 12,
              rirTarget: '0-1',
              restSec: 120,
              notes: 'Estímulo directo al recto femoral; baja en 3 segundos.'
            },
            {
              id: 'ex_pa_5',
              name: 'Gemelos Rodillas Extendidas',
              muscle: 'Gemelos',
              sets: 2,
              repMin: 10,
              repMax: 15,
              rirTarget: '0-1',
              restSec: 90,
              notes: 'Pausa estricta de 2s en estiramiento abajo para anular rebote del tendón.'
            },
            {
              id: 'ex_pa_6',
              name: 'Crunch Abdominal en Polea Alta',
              muscle: 'Core',
              sets: 2,
